{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "quantity": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti|K|M|G|T)?$"},
        {"type": "number", "exclusiveMinimum": 0}
      ]
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "limit"],
      "properties": {"request": {"$ref": "#/definitions/quantity"}, "limit": {"$ref": "#/definitions/quantity"}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"requests": {"$ref": "#/definitions/resourceMap"}, "limits": {"$ref": "#/definitions/resourceMap"}}
    },
    "resourceMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}, "ephemeral-storage": {"$ref": "#/definitions/quantity"}}
    },
    "cidr": {"type": "string", "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"},
    "address": {"type": "string", "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"},
    "addresses": {"type": "array", "items": {"$ref": "#/definitions/address"}},
    "imageRef": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][^\\s@]*(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}|@sha256:[a-f0-9]{64})$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"},
    "positiveInt": {"type": "integer", "minimum": 1},
    "sizeBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"size_limit": {"$ref": "#/definitions/quantity"}}
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"cpu": {"$ref": "#/definitions/pair"}, "memory": {"$ref": "#/definitions/pair"}, "disk": {"$ref": "#/definitions/pair"}}
        },
        "floor": {"type": "integer", "minimum": 0},
        "max_sandboxes": {"$ref": "#/definitions/positiveInt"},
        "refill_seconds": {"$ref": "#/definitions/positiveInt"},
        "margin": {"type": "integer", "minimum": 0},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "node_selector": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholder", "env_name", "key", "hosts"],
      "properties": {
        "placeholder": {"type": "string"},
        "env_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "key": {"type": "string", "pattern": "^[-._a-zA-Z0-9]+$"},
        "hosts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "match_headers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "match_query": {"type": "boolean"},
        "match_path": {"type": "boolean"},
        "match_body": {"type": "boolean"},
        "require_tls": {"type": "boolean"},
        "require": {"type": "boolean"}
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pool": {"$ref": "#/definitions/pool"},
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"service_account": {"type": "string", "minLength": 1}, "namespace": {"type": "string", "minLength": 1}}
        },
        "allow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"domains": {"type": "array", "items": {"type": "string"}}, "cidrs": {"type": "array", "items": {"$ref": "#/definitions/cidr"}}}
        },
        "credential_set": {
          "type": "object",
          "additionalProperties": false,
          "dependencies": {"secret_ref": ["secrets"], "secrets": ["secret_ref"]},
          "properties": {
            "secret_ref": {"$ref": "#/definitions/name"},
            "secrets": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/credential"}}
          }
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cluster_ip": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"},
            "ca": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "certificate": {"type": "string", "pattern": "^(-----BEGIN CERTIFICATE-----[A-Za-z0-9+/=\\s]+-----END CERTIFICATE-----\\s*)+$"},
                "key_secret": {"$ref": "#/definitions/name"}
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace_prefix": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,20}[a-z0-9])?$"},
        "system_namespace": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$"}
      }
    },
    "image": {"$ref": "#/definitions/imageRef"},
    "image_pull_policy": {"type": "string", "enum": ["", "Always", "IfNotPresent", "Never"]},
    "registry_mirror": {"type": "string", "pattern": "^[^\\s@]*$"},
    "pull_secrets": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"repository": {"type": "string", "pattern": "^[^\\s@]+$"}, "digest": {"$ref": "#/definitions/digest"}}
        },
        "mount_path": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$"},
        "size_limit": {"$ref": "#/definitions/quantity"},
        "init_resources": {"$ref": "#/definitions/resources"},
        "seed_container": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"},
            "resources": {"$ref": "#/definitions/resources"}
          }
        }
      }
    },
    "seed": {"$ref": "#/definitions/sizeBlock"},
    "runtimeClassName": {"type": "string"},
    "runAsUser": {"type": "integer", "minimum": 1},
    "runAsGroup": {"type": "integer", "minimum": 1},
    "restore_timeout_seconds": {"$ref": "#/definitions/positiveInt"},
    "idle_ttl": {"type": "integer", "minimum": 0},
    "idle_keep_min_state_bytes": {"type": "integer", "minimum": 0},
    "warm_max_age_seconds": {"$ref": "#/definitions/positiveInt"},
    "save": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl_seconds": {"type": "integer"},
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/[^\\s]+$"}},
        "tombstone_ttl_days": {"$ref": "#/definitions/positiveInt"}
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string"},
        "bucket": {"type": "string"},
        "region": {"type": "string"},
        "path_style": {"type": "boolean"},
        "credentials_secret": {"type": "string"}
      }
    },
    "work": {"$ref": "#/definitions/sizeBlock"},
    "home": {"$ref": "#/definitions/sizeBlock"},
    "pool": {"$ref": "#/definitions/pool"},
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"extra_pods": {"type": "integer", "minimum": 0}}
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pod_cidr": {"$ref": "#/definitions/cidr"},
        "service_cidr": {"$ref": "#/definitions/cidr"},
        "node_addresses": {"$ref": "#/definitions/addresses"},
        "node_public_addresses": {"$ref": "#/definitions/addresses"},
        "load_balancer_addresses": {"$ref": "#/definitions/addresses"},
        "public_resolvers": {"$ref": "#/definitions/addresses"},
        "internal_cidrs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/cidr"}},
        "ipv6": {"type": "string", "enum": ["single_stack", "dual_stack"]},
        "api_server_addresses": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/address"}},
        "store_cidrs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/address"}}
      }
    },
    "clients": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modes"],
        "properties": {"modes": {"type": "object", "additionalProperties": {"$ref": "#/definitions/mode"}}}
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {"type": "string", "pattern": "^([^\\s@/]+/)*[^\\s@/:]+$"},
                "digest": {"$ref": "#/definitions/digest"}
              }
            },
            "replicas": {"$ref": "#/definitions/positiveInt"},
            "resources": {"$ref": "#/definitions/resources"},
            "reload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"key_secret": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$"}}
            },
            "upstream_ca": {
              "type": "object",
              "additionalProperties": false,
              "description": "ConfigMap of the egress namespace mounted read-only in the proxy pod; SSL_CERT_FILE of the proxy points to its key, measured on the pinned proxy image: the roots of that file are added to the roots of the certificate directory of the image, they do not replace them, so the public roots stay trusted and the file alone is enough to trust a private authority; nothing was measured about the default bundle file of the image when SSL_CERT_FILE is set", "required": ["config_map"],
              "properties": {"config_map": {"$ref": "#/definitions/name"}, "key": {"type": "string", "pattern": "^[-._a-zA-Z0-9]+$"}}
            }
          }
        },
        "ca": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}
          }
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"pods": {"$ref": "#/definitions/positiveInt"}}
        }
      }
    },
    "keeper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/imageRef"},
        "replicas": {"$ref": "#/definitions/positiveInt"},
        "settings": {"type": "object"},
        "resources": {"$ref": "#/definitions/resources"},
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duration_seconds": {"$ref": "#/definitions/positiveInt"},
            "renew_deadline_seconds": {"$ref": "#/definitions/positiveInt"},
            "retry_period_seconds": {"$ref": "#/definitions/positiveInt"}
          }
        }
      }
    },
    "network_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/imageRef"},
        "targets": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9.:-]+:[0-9]{1,5}$"}},
        "offlist_host": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "run_id": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,20}[a-z0-9])?$|^$"},
        "cron": {"type": "string"}
      }
    }
  }
}

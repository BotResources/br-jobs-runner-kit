: "${CTX_TEST:=k3d-$CLUSTER_MAIN}"
: "${CTX_CLOSED:=k3d-$CLUSTER_CLOSED}"
: "${NODE_TEST:=k3d-$CLUSTER_MAIN-server-0}"
: "${NODE_CLOSED:=k3d-$CLUSTER_CLOSED-server-0}"
: "${BATTERY_WORK:=$WORK}"
: "${BATTERY_OUT:=$BATTERY_WORK/out}"
: "${CREDS_ENV:=$BATTERY_WORK/creds.env}"
: "${CHART_VALUES_FILE:=$BATTERY_WORK/values-test.yaml}"
: "${CLOSED_VALUES_FILE:=$BATTERY_WORK/values-closed.yaml}"
: "${CLOSED_CREDS_ENV:=$BATTERY_WORK/creds-closed.env}"
: "${TIMING_LOCK:=$BATTERY_WORK/timing.lock.d}"

: "${HELM_RELEASE:=sbx}"
: "${HELM_NAMESPACE:=default}"
: "${NS_PREFIX:=sbx}"
: "${SYSTEM_NS:=$NS_PREFIX-system}"
: "${EGRESS_SUFFIX:=-egress}"
: "${CLIENT_A:=ca}"
: "${CLIENT_B:=cb}"
: "${CLIENT_CANARY:=canary}"
: "${CLIENT_PLATFORM:=platform}"
: "${NET_NONE:=none}"
: "${NET_ALLOW:=allow}"
: "${NET_FULL:=full}"
: "${RS_PREFIX:=warm-}"
: "${RUNNER_SA:=sbx-runner}"
: "${RUNNER_NS:=$NS_PREFIX-runner}"
: "${RUNNER_ID:=system:serviceaccount:$RUNNER_NS:$RUNNER_SA}"
: "${SANDBOX_SA:=sandbox}"
: "${KEEPER_SA:=br-sandbox-keeper}"
: "${KEEPER_DEPLOY:=br-sandbox-keeper}"
: "${KEEPER_NS:=$SYSTEM_NS}"
: "${KEEPER_ID:=system:serviceaccount:$SYSTEM_NS:$KEEPER_SA}"
: "${NETCHECK_SA:=br-sandbox-netcheck}"
: "${NETCHECK_JOB_PREFIX:=br-sandbox-netcheck-}"

: "${LBL_MANAGED:=br.sandbox/managed}"
: "${LBL_EGRESS:=br.sandbox/egress}"
: "${LBL_ROLE:=br.sandbox/role}"
: "${LBL_POOL:=br.sandbox/pool}"
: "${LBL_POOL_ID:=br.sandbox/pool-id}"
: "${LBL_THREAD:=br.sandbox/thread}"
: "${LBL_AGENT:=br.sandbox/agent}"
: "${ROLE_SANDBOX:=sandbox}"
: "${ROLE_PROXY:=proxy}"

: "${SANDBOX_CONTAINER:=agent}"
: "${SANDBOX_PYTHON:=python3}"
: "${SEED_CONTAINER:=seed}"
: "${SEED_PATH:=/skills}"
: "${SEED_BSDTAR:=/sbx/bin/bsdtar}"
: "${TOOLS_MOUNT:=/opt/sbx}"
: "${AGENT_BSDTAR:=$TOOLS_MOUNT/bin/bsdtar}"
: "${SAVE_PATHS:=/work /home/agent}"

: "${PROXY_PORT:=8888}"
: "${PROXY_RELOAD_PORT:=8889}"
: "${STANDIN_POD:=egress-standin}"
: "${STANDIN_PORTS:=$PROXY_PORT $PROXY_RELOAD_PORT 80 443 8080 9090}"
: "${VALUES_IMAGE_KEY:=image}"
: "${VALUES_REGISTRY_MIRROR:=registry_mirror}"
: "${VALUES_PULL_SECRETS:=pull_secrets}"
: "${VALUES_NETWORK_CHECK_RUNID:=network_check.run_id}"
: "${NETWORK_MIN_CONTROL_REACHED:=5}"
: "${WARM_MAX_AGE_VALUE_KEY:=warm_max_age_seconds}"

: "${TESTSVC_NS:=$NS_TESTSVC}"
: "${TEST_HOST_GIT:=$GITEA_HOST}"
: "${TEST_HOST_PKG:=$TEST_HOST_GIT}"
: "${TEST_HOST_ECHO:=canary-echo.$NS_TESTSVC.svc.cluster.local}"
: "${GITEA_DEPLOY:=deploy/$GITEA_SERVICE}"
: "${GITEA_REPO_ROOT:=/var/lib/gitea/git/repositories}"
: "${PLATFORM_REPO:=$GITEA_ORG/$GITEA_REPO}"
: "${TESTCA_CERT:=$BATTERY_WORK/pki/ca.crt}"
: "${TESTCA_KEY:=$BATTERY_WORK/pki/ca.key}"
: "${ECHO_IMAGE:=$PYTHON_IMAGE}"
: "${CAPTURE_IMAGE:=nicolaka/netshoot}"

: "${CANARY_SECRET_NAME:=canary-credentials}"
: "${CANARY_SECRET_KEY:=token}"
: "${CANARY_PLACEHOLDER_ENV:=CANARY_TOKEN}"
: "${PLATFORM_SECRET_NAME:=platform-credentials}"
: "${PLATFORM_GIT_SECRET_KEY:=git-token}"
: "${PLATFORM_PKG_SECRET_KEY:=pkg-token}"
: "${PLATFORM_GIT_PLACEHOLDER_ENV:=GIT_TOKEN}"
: "${PLATFORM_PKG_PLACEHOLDER_ENV:=PKG_TOKEN}"
: "${PLATFORM_CARGO_REGISTRY:=$CARGO_REGISTRY_NAME}"

: "${CLOSED_MIRROR_HOST:=mirror.sbx-closed.test:5000}"
: "${CLOSED_PULL_SECRET:=mirror-pull}"
: "${VENDOR_HOST_REGEX:=iron\\.sh|docker\\.io|registry-1\\.docker\\.io|hub\\.docker\\.com|index\\.docker\\.io|ghcr\\.io|quay\\.io|gcr\\.io|registry\\.k8s\\.io|mcr\\.microsoft\\.com}"
: "${VENDOR_TOKEN_REGEX:=IRON_PROXY_TOKEN}"
: "${TOOLS_PAUSE:=/sbx/bin/pause}"
: "${GATE_NS:=$NS_NETPOL_PROBE}"
